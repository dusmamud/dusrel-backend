# auth-api — example env file (signup/login service)
#
# Ise copy karke .env banao: cp .env.example .env
# .env KABHI Git me commit mat karo (gitignore me hai).
# Real secrets sirf in 3 jagah me se ek par dalne hain:
#
# 1. LOCAL laptop par: isi folder me .env banao, phir is tarah
#    chalao (Node 24 ka built-in --env-file, koi dotenv package
#    nahi chahiye — .env file apne aap load NAHI hoti):
#      node --env-file=.env dist/src/index.js
#    (Sirf `pnpm start` chalane par .env ignore ho jayega.)
#
# 2. VPS Docker par: .env yahan NAHI, balki
#    services/mail-server/.env me dalo — compose wahi file se
#    AUTH_JWT_SECRET utha kar container ko deta hai.
#
# 3. Render par: koi file nahi — Render dashboard > service >
#    Environment Variables me dalo.
#
# Production me AUTH_JWT_SECRET set nahi hua to service start hi
# nahi hogi (code me throw hai) — dev default sirf local ke liye
# hai, warning ke saath. Secret banao: openssl rand -hex 32
# Ye secret mail-api ke MAIL_JWT_SECRET se WAHI hona chahiye,
# warna mail-api auth-api ke tokens reject kar dega.
#
# NODE_ENV (pehle examples me missing tha — cross-verification
# me pakda gaya): production throw-guard sirf tab chalta hai jab
# NODE_ENV=production ho. VPS Docker par compose ye khud set
# karta hai (docker-compose.yml me hardcoded hai), lekin Render
# aur local par tumko khud set karna hoga:
#   NODE_ENV=production
# Local dev par isko unset ya development rakho, warna secret
# set kiye bina service start hi nahi hogi.
# NODE_ENV=production

PORT=3001
AUTH_JWT_SECRET=change-me-64-hex-chars
# AUTH_APP_URL se reset-password aur invite-accept ke LINKS bante
# hain (authService.ts me verified) — isliye ye value wahi honi
# chahiye jahan reset/invite pages rehte hain. Local ke liye
# neeche wali theek hai. VPS wali value OPEN hai (lock nahi hui):
# mail-server/.env.example me abhi mail app ka URL hai, jabki
# recovery pages account centre me hain — VPS run se pehle iski
# sahi value lock karni hai, yahan andaze se mat badlo.
AUTH_APP_URL=http://localhost:3000
# AUTH_CORS_ORIGIN: code SINGLE origin leta hai (app.ts me
# `origin: config.corsOrigin` verified). Local ke liye neeche wali
# theek hai. VPS par OPEN GAP hai: auth-api ko mail app ke saath
# account centre bhi call karega, aur single origin me doosri
# origin cover nahi hoti — account centre se calls CORS par fail
# hongi. Iske liye code me origin list support chahiye (abhi kaam
# baaki hai); tab tak VPS par is value ko badal kar ek origin ko
# fix karne se doosri toot jayegi, isliye yahan koi doosri value
# andaze se mat jodo.
AUTH_CORS_ORIGIN=http://localhost:3000
# return_to allowlist (docs/28, account centre login/signup redirect):
# comma-separated hosts. Set nahi hua to default list lagti hai —
# mail.dusrel.com, drive.dusrel.com, chat.dusrel.com,
# meet.dusrel.com, account.dusrel.com, dusrel.com (exact match,
# suffix trick nahi chalega). Sirf https allowed hai; localhost par
# http sirf tab jab NODE_ENV production NAHI hai AUR localhost is
# list me ho (default list me localhost hai hi nahi).
# Example (local dev ke liye): AUTH_RETURN_TO_HOSTS=localhost,mail.dusrel.com,account.dusrel.com,dusrel.com
# AUTH_RETURN_TO_HOSTS=
# Baaki numbers (token TTL, OTP, invite) starting values hain —
# src/config.ts me defaults hain, zaroorat par hi env se badlo:
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_RESET_TOKEN_TTL_SECONDS=3600
# AUTH_INVITE_TTL_SECONDS=86400
# AUTH_OTP_TTL_SECONDS=600
# AUTH_OTP_MAX_ATTEMPTS=5
