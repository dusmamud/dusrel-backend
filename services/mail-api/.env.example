# mail-api — example env file (app-level mail API)
#
# Ise copy karke .env banao: cp .env.example .env
# .env KABHI Git me commit mat karo (gitignore me hai).
# Real secrets sirf in 3 jagah me se ek par dalne hain:
#
# 1. LOCAL laptop par: isi folder me .env banao, phir is tarah
#    chalao (Node 24 ka built-in --env-file, koi dotenv package
#    nahi chahiye — .env file apne aap load NAHI hoti):
#      node --env-file=.env dist/src/index.js
#    (Sirf `pnpm start` chalane par .env ignore ho jayega.)
#
# 2. VPS Docker par: .env yahan NAHI, balki
#    services/mail-server/.env me dalo — compose wahi file se
#    MAIL_JWT_SECRET utha kar container ko deta hai.
#
# 3. Render par: koi file nahi — Render dashboard > service >
#    Environment Variables me dalo.
#
# SABSE ZAROORI RULE: MAIL_JWT_SECRET wahi hona chahiye jo
# auth-api me AUTH_JWT_SECRET hai. Dono alag hue to mail-api
# har token reject karega (signature verify nahi hogi).
# Production me secret set nahi hua to service start hi nahi hogi.
# Secret banao: openssl rand -hex 32
#
# FALLBACK (code me verified, pehle example me missing tha):
# MAIL_JWT_SECRET set nahi hua to mail-api AUTH_JWT_SECRET par
# gir jati hai (config.ts me `MAIL_JWT_SECRET ?? AUTH_JWT_SECRET`).
# Lekin is fallback par bharosa mat karo — neeche wali COMPOSE
# TRAP ki wajah se VPS par ye kaam nahi karega.
#
# COMPOSE TRAP (docker-compose.yml se verified): mail-api
# container ko sirf MAIL_JWT_SECRET milta hai, AUTH_JWT_SECRET
# nahi milta. Isliye VPS par sirf AUTH_JWT_SECRET set karne se
# mail-api production me throw karegi (fallback var container me
# hai hi nahi). VPS par mail-server/.env me DONO vars set karna
# zaroori hai, ek se kaam nahi chalega.
#
# NODE_ENV (pehle example me missing tha): production throw-guard
# sirf tab chalta hai jab NODE_ENV=production ho. VPS Docker par
# compose ye khud set karta hai, lekin Render aur local par
# tumko khud set karna hoga:
#   NODE_ENV=production
# NODE_ENV=production

PORT=3002
MAIL_JWT_SECRET=change-me-64-hex-chars
# MAIL_CORS_ORIGIN: code SINGLE origin leta hai (app.ts me
# verified). Mail-api ko sirf mail app call karti hai, isliye
# local ke liye neeche wali aur VPS par mail app ka URL hi sahi
# hai — isme account centre wali problem nahi hai (wo sirf
# auth-api ki hai).
MAIL_CORS_ORIGIN=http://localhost:3000
