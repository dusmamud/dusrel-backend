# Dusrel Mail VPS stack — example env file (v1 slice)
#
# Ise copy karke .env banao: cp .env.example .env
# .env KABHI Git me commit mat karo (gitignore me hai).
# Har value ke liye placeholder diya gaya hai — real value VPS par
# set karo. JWT secrets ke liye: openssl rand -hex 32
#
# Domain (final domain abhi lock nahi hua hai — docs me
# dusrel.com / mail.dusrel.com sirf example hain).
DOMAIN=dusrel.com
ACME_EMAIL=admin@example.com

# Hono APIs — dono services ko WAHI JWT secret chahiye, kyunki
# mail-api auth-api ke tokens ko signature se verify karta hai.
# Dono alag-alag secrets hue to mail-api har token reject karega.
AUTH_JWT_SECRET=change-me-64-hex-chars
MAIL_JWT_SECRET=change-me-64-hex-chars
AUTH_APP_URL=https://mail.dusrel.com
AUTH_CORS_ORIGIN=https://mail.dusrel.com
MAIL_CORS_ORIGIN=https://mail.dusrel.com

# Backup + monitoring (scripts/backup.sh + scripts/disk-alert.sh
# ke liye — ye values VPS host ke env/crontab me hongi, compose
# inhe pass nahi karta).
# BACKUP_DIR=/var/backups/dusrel-mail
# R2_SOURCE_BUCKET=dusrel-mail-blobs
# R2_BACKUP_BUCKET=dusrel-mail-blobs-backup
# ALERT_WEBHOOK_URL=https://ntfy.sh/dusrel-alerts-example

# Cloudflare R2 (Stalwart blob store, WebUI me set hoga — ye values
# yahan sirf reference ke liye hain, compose inhe Stalwart ko
# directly pass nahi karta; R2 credentials WebUI > Storage > Blob
# Store me dalne hain, env me kabhi commit nahi karne hain).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=dusrel-mail-blobs
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
