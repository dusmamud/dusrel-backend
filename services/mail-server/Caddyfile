# Caddy reverse proxy — sirf HTTP APIs ke liye (v1 slice)
#
# Caddy automatic HTTPS (ACME) deta hai API domains ke liye.
# SMTP/IMAP yahan se proxy NAHI hote — wo Stalwart ke ports
# (25/465/587/993) par seedha chalte hain.
#
# {$DOMAIN} aur {$ACME_EMAIL} .env se aate hain (compose me
# environment se pass hote hain). Example: DOMAIN=dusrel.com ho
# to mail-api mail-api.dusrel.com par chalega (docs/10 ka
# service-domain rule). auth-api wala route template rehta hai
# (future VPS use ke liye, user choice 2026-10-31), lekin
# current plan me auth-api ka public URL Orgo VM ke Cloudflare
# Tunnel se aayega — isliye auth.dusrel.com ko public URL mat
# samjho. Account centre (login/recovery pages)
# account.dusrel.com hai, jo AUTH_APP_URL me lock hai
# (mail-server/.env.example dekho).

{
	email {$ACME_EMAIL}
}

auth.{$DOMAIN} {
	reverse_proxy auth-api:3001
}

mail-api.{$DOMAIN} {
	reverse_proxy mail-api:3002
}
