{
  "name": "dusrel-backend",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:turbo": "turbo build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "pnpm --filter @dusrel/auth-api test && pnpm --filter @dusrel/mail-api test && pnpm --filter @dusrel/address test && pnpm --filter @dusrel/crypto test",
    "typecheck": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.1"
  },
  "version": "0.1.0"
}